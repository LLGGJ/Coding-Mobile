<?xml version="1.0" encoding="utf-8"?>
<!-- Código Mobile app icon / Android 12+ splash animated icon. Kept at this
     exact path because config.xml's AndroidWindowSplashScreenAnimatedIcon
     preference points at it directly; it wraps the raster logo in
     res/android/mipmap-*/ic_launcher_foreground.png, which Android resolves
     to the right density automatically. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_foreground"
    android:gravity="center" />
